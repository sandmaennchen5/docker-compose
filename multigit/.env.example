WEB_USER=admin
WEB_PASSWORD=
WEB_PORT=8088
BIND_ADDRESS=127.0.0.1
# Fuer reproduzierbare Builds einen Commit oder Tag statt master eintragen.
MULTIGIT_REF=master

# Optional: stabiles Masterpasswort fuer den Token-Keyring.
# Ohne Angabe wird WEB_PASSWORD verwendet; Passwort bei bestehenden Daten beibehalten.
KEYRING_PASSWORD=
