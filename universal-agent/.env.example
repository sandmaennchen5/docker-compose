TZ=Europe/Berlin
HOSTNAME=docker-host

ENABLE_PORTAINER=false
ENABLE_HAWSER=false
ENABLE_PORTWING=false
ENABLE_DRYDOCK=false

# Native Drydock: set ENABLE_PORTWING=false and ENABLE_DRYDOCK=true.
# Uses PORTWING_PORT (default 3000). Secret must match the controller.
DD_AGENT_SECRET=
# Optional alternative: /run/secrets/portwing_token
DD_AGENT_SECRET_FILE=
DD_SERVER_TLS_ENABLED=false
DD_SERVER_TLS_KEY=
DD_SERVER_TLS_CERT=

PORTAINER_PORT=9001
PORTAINER_AGENT_SECRET=
PORTAINER_AGENT_SECRET_FILE=/run/secrets/portainer_agent_secret

HAWSER_PORT=2376
HAWSER_TOKEN=
HAWSER_TOKEN_FILE=/run/secrets/hawser_token
HAWSER_SERVER_URL=
# Timeouts in seconds; Compose up/down/pull has its own budget.
HAWSER_REQUEST_TIMEOUT=30
HAWSER_COMPOSE_TIMEOUT=900

PORTWING_PORT=3000
PORTWING_TOKEN=
PORTWING_TOKEN_FILE=/run/secrets/portwing_token
